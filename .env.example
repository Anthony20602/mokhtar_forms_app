# Copy this file to .env.local and adjust.

# PostgreSQL connection: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# The database itself is created for you by `npm run db:setup`.
DATABASE_URL=postgres://postgres:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/mokhtar

# Optional: ask for a password before anyone on the network can open the app.
# Leave empty to disable the login screen.
APP_PASSWORD=

# Optional overrides (normally auto-detected).
# BROWSER_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
